# ============================================================
# Whitelist — repo PUBLIC : on ignore TOUT sauf les fichiers
# strictement nécessaires au fonctionnement du site.
# ============================================================

# 1. Ignorer tout par défaut
*

# 2. Autoriser uniquement les fichiers du site
!index.html
!CNAME
!i18n.json
!locales/
!locales/*.json
!og-image.jpg
!favicon.svg
!cours-femmes/
!cours-femmes/index.html
!cours-femmes/og-image-femmes.jpg
!cours-coran/
!cours-coran/index.html
!cours-coran/og-image-coran.jpg

# Hub (09/11/2026) : pages générées par outils/construire.py
!mentions-legales.html
!politique-confidentialite.html
!sitemap.xml
!robots.txt
!assets/
!assets/**
!cours/
!cours/**
!apprendre/
!apprendre/index.html
!donnees/
!donnees/ecoles.json
!outils/
!outils/construire.py
!outils/gabarits/
!outils/gabarits/*.html
!.github/
!.github/workflows/
!.github/workflows/*.yml


# 3. Autoriser git lui-même et ce fichier
!.gitignore
!.git/

# ── Fichiers exclus (sensibles ou inutiles en production) ──
# apps-script/     → contient la Secret Key Turnstile
# README_*.md      → documentation interne
# og-image-generator.html → outil de génération, pas le site
